{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disposition de clavier, format natif",
  "description": "Décrit le fichier de disposition consommé par TypingEngine.Core, tel qu'il existe — pas seulement les champs que le parseur lit. Sans $id : ce schéma n'est publié à aucune URL, il vit dans ce dépôt. Distinct du manifeste OKLM, qui est un format d'export produit en aval par un convertisseur.",
  "type": "object",
  "required": ["layout_name", "version", "rows", "dead_keys", "statistics"],
  "additionalProperties": false,
  "properties": {
    "layout_name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "release_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "author": { "type": "string" },
    "website": { "type": "string" },
    "license": { "type": "object" },
    "platforms": { "type": "object" },
    "keyboard_type": { "type": "object" },
    "country": { "type": "string" },
    "description": { "type": "string" },
    "philosophy": { "type": "object" },
    "changes_from_traditional_azerty": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "unchanged_from_traditional": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conventions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "statistics": {
      "description": "Ces cinq entiers se recalculent depuis rows et dead_keys ; le contrôle qui les recoupe vit hors du schéma, JSON Schema ne sachant pas compter.",
      "type": "object",
      "required": [
        "physical_keys",
        "direct_characters",
        "dead_keys_count",
        "dead_key_combinations",
        "total_unique_characters",
        "supported_languages"
      ],
      "additionalProperties": false,
      "properties": {
        "physical_keys": { "type": "integer", "minimum": 0 },
        "direct_characters": { "type": "integer", "minimum": 0 },
        "dead_keys_count": { "type": "integer", "minimum": 0 },
        "dead_key_combinations": { "type": "integer", "minimum": 0 },
        "total_unique_characters": { "type": "integer", "minimum": 0 },
        "supported_languages": { "type": "string" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["row_id", "row_name", "keys"],
        "additionalProperties": false,
        "properties": {
          "row_id": { "type": "integer", "minimum": 1 },
          "row_name": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/key" }
          }
        }
      }
    },
    "dead_keys": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^dk_[a-z0-9_]+$" },
      "additionalProperties": { "$ref": "#/$defs/deadKey" }
    }
  },
  "$defs": {
    "layer": {
      "description": "Un caractère produit, un jeton dk_* qui arme une touche morte, ou null quand la couche ne produit rien.",
      "type": ["string", "null"]
    },
    "key": {
      "type": "object",
      "required": [
        "position",
        "scancode",
        "vk",
        "base",
        "shift",
        "alt_gr",
        "shift_alt_gr",
        "finger"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "description": "Repère physique ISO : rangée A à E, puis deux chiffres.",
          "type": "string",
          "pattern": "^[A-E][0-9]{2}$"
        },
        "scancode": {
          "description": "Les trois seules formes que ParseScancode accepte : préfixe SC en hexadécimal, préfixe 0x en hexadécimal, sinon décimal. Une chaîne quelconque satisfait « type string » et fait lever uint.Parse au démarrage — d'où ce pattern.",
          "type": "string",
          "pattern": "^(?:[Ss][Cc][0-9A-Fa-f]{1,8}|0[Xx][0-9A-Fa-f]{1,8}|[0-9]{1,10})$"
        },
        "vk": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "finger": {
          "type": "string",
          "enum": [
            "left_pinky",
            "left_ring",
            "left_middle",
            "left_index",
            "right_index",
            "right_middle",
            "right_ring",
            "right_pinky",
            "thumb"
          ]
        },
        "base": { "$ref": "#/$defs/layer" },
        "shift": { "$ref": "#/$defs/layer" },
        "alt_gr": { "$ref": "#/$defs/layer" },
        "shift_alt_gr": { "$ref": "#/$defs/layer" },
        "caps": { "$ref": "#/$defs/layer" },
        "caps_shift": { "$ref": "#/$defs/layer" },
        "caps_alt_gr": { "$ref": "#/$defs/layer" },
        "caps_shift_alt_gr": { "$ref": "#/$defs/layer" }
      }
    },
    "deadKey": {
      "type": "object",
      "required": ["description", "example", "table"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "example": { "type": "string" },
        "design_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "table": {
          "description": "Touche suivante composée vers le caractère produit. La clé fait exactement un caractère : une clé plus longue ne serait jamais atteinte par une frappe et disparaîtrait en silence.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1, "maxLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
