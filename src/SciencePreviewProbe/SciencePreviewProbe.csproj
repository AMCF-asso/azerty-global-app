<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sonde d'aperçu (spike du 2026-11-04) : le math RichEdit de msftedit.dll construit-il la
       sortie UnicodeMath du moteur ? Ouvre une fenêtre RichEdit, y bâtit chaque formule
       (zone math + ITextRange2::BuildUpMath), capture la fenêtre en BMP et imprime les HRESULT.
       Outil de mesure, pas du code de l'app : les appels COM passent par la vtable (unsafe) ;
       l'intégration utilisera [GeneratedComInterface] comme ToastActivation.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AZERTYGlobal</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ScienceEngine.cs" Link="ScienceEngine.cs" />
  </ItemGroup>

  <Import Project="..\ScienceEngine.targets" />

</Project>
